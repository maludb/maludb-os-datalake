# The lake's WRITER (design §6.1): the ONLY process that writes Parquet under {{DL_STORAGE_DIR}}/lake and DML on the ducklake schema.
# It works the lake_jobs queue (load, promote, transform, profile, checks, export, maintenance, erasure, rollback, backup_lock).
# The entry point services/lake/writer_main.py is the engine worker's (services/ — Phase 0's engine proof). Its database connection is
# DL_LAKE_DB_DSN (the datalake_lake role), read from config/.env by systemd (EnvironmentFile) — the writer's user need not read the file.
# It reaches outward (an http_file or sftp_file source, the kernel's K7 on loopback, an outside PostgreSQL), so no IP filter here; the
# query service is the one with none.
[Unit]
Description=Data Lake writer — the only writer of the lake (the lake_jobs queue)
After=network.target postgresql.service

[Service]
Type=simple
User=datalake-writer
Group=datalake
WorkingDirectory={{APP_DIR}}
EnvironmentFile={{APP_DIR}}/config/.env
Environment=PYTHONUNBUFFERED=1
ExecStart={{APP_DIR}}/services/.venv/bin/python {{APP_DIR}}/services/lake/writer_main.py
Restart=on-failure
RestartSec=5
# files it makes: group-readable (the query service reads lake/ by group datalake; PHP serves exports/ by group www-data, setgid there)
UMask=0027
# memory: dl_settings.writer_memory_mb (3 GB) is DuckDB's limit; this is the hard ceiling over it
MemoryMax=3584M
TasksMax=128
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{DL_STORAGE_DIR}}
ReadOnlyPaths={{APP_DIR}}

[Install]
WantedBy=multi-user.target
