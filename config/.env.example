# Data Lake — config/.env (written by the kernel's installer at apply, and by deploy/ROOT_STEPS.sh and deploy/os-provision.sh for the
# engine's keys; design §14). Never commit the real file. Group www-data and the engine's group `datalake` read it; nothing in it is ever
# logged, printed or returned.
APP_ENV=prod
APP_DEBUG=0
APP_NAME="Data Lake"
APP_KEY=datalake
APP_URL=https://datalake.example.com
# the record database (the installer creates it and the three roles; the lake's catalog is schema `ducklake` of the SAME database)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=subello_datalake
DB_USER=datalake_rw
DB_PASSWORD=
MCP_RECORDS_DB_USER=datalake_records_ro
MCP_RECORDS_DB_PASSWORD=
MCP_ACTIVITY_DB_USER=datalake_activity_ro
MCP_ACTIVITY_DB_PASSWORD=
# the ports (pinned before the first apply: deploy/ROOT_STEPS.sh step 1)
APP_INTERNAL_PORT=8193
MCP_RECORDS_PORT=8847
MCP_ACTIVITY_PORT=8848
# the kernel's (copied by the installer)
ACTION_TOKEN_KEY=
ACTIONS_RELAY_KEY=
OS_APPLICATION_TOKEN=
OS_INTERNAL_URL=http://127.0.0.1:8080
OS_LAUNCHER_URL=https://app.example.com/
# the tenant's one memory (activity episodes) — the lake keeps no memory database of its own (D2)
MALUDB_API_URL=http://127.0.0.1:8000
MALUDB_API_TOKEN=
# mail (optional; the installer fills them from ~/.malumail or the kernel's) — notifications only; the lake reads no mailbox
MALUMAIL_API_URL=https://api.malumail.com
MALUMAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
# ---- the engine (design §6.1, §6.5, §14) ----------------------------------------------------------------------------------------------
# The data directory: a DEDICATED VOLUME mounted at /srv/lake (the owner's (a), 2026-10-10). landing/ (uploads and pulls, as received),
# lake/ (DuckLake's DATA_PATH — the writer's alone, readable by the query service, NEVER by www-data), exports/, tmp/ (DuckDB's spill,
# capped), backup/. ROOT_STEPS.sh step 3 refuses a directory on PostgreSQL's filesystem.
DL_STORAGE_DIR=/srv/lake
# where deploy/backup.sh puts the catalog dump and the file copy (default $DL_STORAGE_DIR/backup; an offsite target is the owner's)
DL_BACKUP_DIR=
# the query service's Unix socket (systemd RuntimeDirectory=datalake; group www-data and the MCP services' user may connect)
DL_QUERY_SOCKET=/run/datalake/query.sock
# the pool's size and the memory per worker / for the writer — may only LOWER dl_settings (query_workers, query_memory_mb, writer_memory_mb);
# the units' MemoryMax is the hard ceiling
DL_QUERY_WORKERS=
DL_QUERY_MEMORY=
DL_WRITER_MEMORY=
# DuckDB's extensions, vendored once for the pinned version into a root-owned read-only directory (ROOT_STEPS.sh step 5); autoinstall off
DL_EXTENSION_DIR=/var/lib/datalake/duckdb_extensions
# the engine's two database roles (written by deploy/os-provision.sh): the writer's (datalake_lake: owner of schema ducklake) and the
# query service's (datalake_query: SELECT on ducklake.*), as libpq conninfo with a PASSFILE — never a password (duckdb_databases()
# prints an attached catalog's conninfo verbatim; the engine refuses `password=`): host=… port=… dbname=… user=datalake_lake
# passfile=/etc/datalake/lake.pgpass. Read ONLY by services/; PHP and the MCP servers never connect as either.
DL_LAKE_DB_DSN=
DL_QUERY_DB_DSN=
# the installation's masking salt (32 random bytes, root:datalake-query 0440, ROOT_STEPS.sh step 6) — read by the query service alone;
# dl_settings.mask_salt_id names its version
DL_MASK_SALT_FILE=/etc/datalake/mask_salt
# CORS origins for the token API, comma-separated (none by default)
API_CORS_ORIGINS=
